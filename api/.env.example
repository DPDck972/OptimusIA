# ============================================================
# OPTIMUS IA - BACKEND ENVIRONMENT CONFIGURATION
# ============================================================
# 1. Copy this file: cp api/.env.example api/.env
# 2. Fill in your values below
# 3. NEVER commit the .env file!
# ============================================================

# ===== SERVER =====
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=True

# ===== AUTHENTICATION =====
# Must match VITE_API_KEY in the root .env file
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=<your-api-key-here>

# ===== CORS =====
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== RATE LIMITING =====
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# ===== LLM (Choose ONE) =====

# Option 1: Ollama (local, no API key needed)
LLM_MODEL=qwen3.5:4b
LLM_URL=http://localhost:11434/v1
# LLM_API_KEY=not_required

# Option 2: OpenAI (comment Ollama above, uncomment below)
# LLM_MODEL=gpt-4o-mini
# LLM_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-key-here

# Option 3: Groq
# LLM_MODEL=llama-3.1-70b-versatile
# LLM_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk-your-groq-key-here

# Option 4: Claude / Anthropic (via OpenAI-compatible adapter)
# LLM_MODEL=claude-3-5-sonnet-20241022
# LLM_URL=https://api.anthropic.com/v1
# LLM_API_KEY=your-anthropic-key-here

# LLM request timeout (seconds)
LLM_TIMEOUT=120

# ===== SECURITY =====
# Allows the agent to execute Python code on the DataFrame
# Set to False in production (requires sandboxing)
ALLOW_DANGEROUS_CODE=True

# Maximum query length in characters
MAX_QUERY_LENGTH=1000

# ===== DATA =====
DATA_FILE=dados.xlsx

# ===== EMBEDDING (RAG) =====
# Modelo de embedding via Ollama (CPU, ~275MB)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_URL=http://localhost:11434
EMBEDDING_DIMENSION=768

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FILE=logs/api.log
